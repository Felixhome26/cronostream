# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env / secrets
.env
.env.local

# Stream project data (user's own life-timeline projects should not land in this repo)
*.cronostream/
# Same, from before the rename to CronoStream
*.lifestream/

# KI-Metadaten export/import files (personal file listings — save dialogs
# default into the repo root if the user doesn't redirect them elsewhere)
cronostream-ki-metadaten-export_*.txt
lifestream-ki-metadaten-export_*.txt

# Machine-local cargo config (redirects the build output dir to a drive
# with more free space — an absolute path specific to this machine, not
# something to commit)
src-tauri/.cargo/

# Claude Code: machine-local permissions, not shared
.claude/settings.local.json

# LibreOffice-Sperrdateien, die beim Öffnen der Recherche-Dokumente entstehen
.~lock.*#

# Tutorial screenshots and PDFs, generated by scripts/anleitung/ (large, reproducible)
cronostream screenshots/anleitung-*/
# Walkthrough screenshots, generated by scripts/e2e/rundgang.mjs
cronostream screenshots/rundgang-*/
docs/sprachpruefung/arbeit/
