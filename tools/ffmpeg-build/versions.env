# Exact source versions of every stream ffmpeg build. Changing one of
# these and tagging a new release is all an update takes.
FFMPEG_VERSION=n8.1.3
# Linux AppImage only: the major version must match the build machine's
# libavcodec.so.60 (see build-linux.sh).
FFMPEG_LINUX_VERSION=n6.1.6
LIBVPX_VERSION=v1.17.0
OPUS_VERSION=v1.6.1
# Windows only (PNG/TIFF decoders); macOS uses the system zlib.
ZLIB_VERSION=v1.3.2
